# Copy to .env or backend/.env and fill locally. Never commit real values.

# Chat model provider credential.
GONGWEN_LLM_API_KEY=

# Embedding provider credential.
GONGWEN_EMBEDDING_API_KEY=

# Required only for full_article_drafting.
# Use an absolute path to a private JSON pack outside this repository.
# Missing or invalid configuration fails closed before retrieval/model calls.
WRITING_REFERENCE_PACK_PATH=

# Optional feature flags (default false).
QUALITY_TEST_MODE=false
ENABLE_WRITING_STYLE_LIBRARY=false

# Optional local ports.
BACKEND_PORT=8000
FRONTEND_PORT=5177
